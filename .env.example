# DevRev Personal Access Token (never commit real values).
# Required by: doctor, start, apply, verify (and forwarded to the DevRev MCP).
DEVREV_PAT=

# Optional: set to 1 when using beta-only APIs (e.g. some incident flows).
# DEVREV_BETA=0

# DevRev PAT for your internal org — used by `dia research` (read-only).
# This PAT is NEVER used for create/update/delete operations.
DEVREV_RESEARCH_PAT=

# Anthropic API key for Claude — required by `start` and `plan` when synthesizing
# from a natural-language brief. Not needed if you only use --blueprint.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-6 in code).
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-opus-4-7

# DevRev MCP server. By default the agent spawns itself — `dia mcp-serve` —
# which exposes `search` and `get_object` against the DevRev REST API using
# the same DEVREV_PAT. Override only if you want to point at a different
# MCP server (e.g. a community Python implementation, or DevRev's own if/when
# they publish one).
# DEVREV_MCP_COMMAND=dia
# DEVREV_MCP_ARGS=mcp-serve
