{
  "version": 1,
  "title": "Tags, stages & groups smoke test",
  "summary": "Validates tags.create, stages.custom.create, and groups.create API integration. Includes a minimal product hierarchy and one ticket for context.",
  "steps": [
    {
      "id": "part-1",
      "kind": "create_part",
      "title": "Create product: TSG Smoke Product",
      "rationale": "Blueprint part",
      "payload": {
        "manifest_ref": "prod:tsg",
        "body": {
          "type": "product",
          "name": "TSG Smoke Product",
          "owned_by": [
            "SELF"
          ]
        }
      }
    },
    {
      "id": "part-2",
      "kind": "create_part",
      "title": "Create capability: TSG Smoke Capability",
      "rationale": "Blueprint part (parent ref: prod:tsg)",
      "payload": {
        "manifest_ref": "cap:tsg",
        "parent_ref": "prod:tsg",
        "body": {
          "type": "capability",
          "name": "TSG Smoke Capability",
          "owned_by": [
            "SELF"
          ],
          "parent_part": {
            "__ref": "prod:tsg"
          }
        }
      }
    },
    {
      "id": "part-3",
      "kind": "create_part",
      "title": "Create feature: TSG Smoke Feature",
      "rationale": "Blueprint part (parent ref: cap:tsg)",
      "payload": {
        "manifest_ref": "feat:tsg",
        "parent_ref": "cap:tsg",
        "body": {
          "type": "feature",
          "name": "TSG Smoke Feature",
          "owned_by": [
            "SELF"
          ],
          "parent_part": {
            "__ref": "cap:tsg"
          }
        }
      }
    },
    {
      "id": "work-4",
      "kind": "create_work",
      "title": "Create ticket: TSG smoke ticket — billing question",
      "rationale": "Blueprint work ref=tic:tsg-1",
      "payload": {
        "manifest_ref": "tic:tsg-1",
        "body": {
          "type": "ticket",
          "title": "TSG smoke ticket — billing question",
          "body": "Test ticket to validate alongside tags/stages/groups.",
          "applies_to_part": {
            "__ref": "feat:tsg"
          },
          "owned_by": [
            "SELF"
          ],
          "external_ref": "tsg-smoke-tic-1",
          "severity": "medium"
        }
      }
    },
    {
      "id": "tag-5",
      "kind": "create_tag",
      "title": "Create tag: billing",
      "rationale": "Blueprint tag ref=tag:billing",
      "payload": {
        "manifest_ref": "tag:billing",
        "body": {
          "name": "billing",
          "description": "Billing and payment issues"
        }
      }
    },
    {
      "id": "tag-6",
      "kind": "create_tag",
      "title": "Create tag: onboarding",
