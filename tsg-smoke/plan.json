    },
    {
      "id": "tag-7",
      "kind": "create_tag",
      "title": "Create tag: bug",
      "rationale": "Blueprint tag ref=tag:bug",
      "payload": {
        "manifest_ref": "tag:bug",
        "body": {
          "name": "bug"
        }
      }
    },
    {
      "id": "tag-8",
