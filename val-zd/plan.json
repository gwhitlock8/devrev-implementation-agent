{
  "version": 1,
  "title": "Zendesk → DevRev migration POC",
  "summary": "Parallel-run DevRev environment seeded for a Zendesk customer. Zendesk 'brands' and 'ticket forms' map to DevRev parts. Auto-detects Zendesk CSV exports (lowercase id/requester/assignee headers).",
  "ui_guidance_sections": [
    {
      "title": "Map Zendesk priorities to DevRev",
      "doc_links": [
        "https://devrev.ai/docs/product/tickets"
      ],
      "steps": [
        "Zendesk Urgent → DevRev priority p0",
        "Zendesk High → p1",
        "Zendesk Normal → p2",
        "Zendesk Low → p3"
      ]
    },
    {
      "title": "Migrating Zendesk Help Center articles",
      "doc_links": [
        "https://developer.zendesk.com/api-reference/help_center/help-center-api/articles/"
      ],
      "steps": [
        "Export Help Center articles from Zendesk via the Help Center API or the Admin export tool.",
        "Convert the export to a CSV with at minimum 'title' and 'body' columns (Markdown body is fine — DevRev articles accept Markdown).",
        "Add a blueprint csv entry: `{ \"path\": \"./zd-articles.csv\", \"entity\": \"articles\" }`.",
        "Re-run `dia plan` and `dia apply` to ingest."
      ]
    },
    {
      "title": "Zendesk Brand → DevRev Part mapping",
      "steps": [
        "If your Zendesk org uses multiple Brands, model each Brand as a top-level capability under the Platform product.",
        "Each Brand's ticket forms become features under that capability.",
        "Adjust the parts hierarchy in this blueprint to mirror your Brand structure before applying."
      ]
    },
    {
      "title": "Importing your real Zendesk export",
      "steps": [
        "Export tickets from Zendesk Admin → Manage → Reports → Export.",
        "Drop the CSV next to this blueprint and add a `csv` entry: `{ \"path\": \"./zd-tickets.csv\", \"entity\": \"tickets\" }`.",
        "The agent auto-detects Zendesk headers (id, requester, assignee, group, priority) and applies the column map automatically."
      ]
    }
  ],
