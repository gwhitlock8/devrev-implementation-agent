{
  "version": 1,
  "title": "Freshdesk → DevRev migration POC",
  "summary": "Stand up a parallel-run DevRev environment seeded with KB articles, sample tickets, and the parts/SLA scaffolding a Freshdesk customer expects. Drop your Freshdesk export CSVs in `csv` to import real tickets/contacts; the agent auto-detects Freshdesk headers.",
  "ui_guidance_sections": [
    {
      "title": "Map Freshdesk priorities to DevRev",
      "doc_links": [
        "https://devrev.ai/docs/product/tickets"
      ],
      "steps": [
        "Freshdesk Urgent → DevRev priority p0",
        "Freshdesk High → p1",
        "Freshdesk Medium → p2",
        "Freshdesk Low → p3",
        "Verify the mapping in your CSV column_map (use 'priority_name' → 'priority' if you exported from Freshdesk's default columns)."
      ]
    },
    {
      "title": "SLA policy parity with Freshdesk",
      "doc_links": [
        "https://devrev.ai/docs/product/sla"
      ],
      "steps": [
        "Settings → SLA Policies → Create",
        "Recreate your Freshdesk SLA bands by severity: First-response and Resolution targets per priority.",
        "Apply per-account using the same Enterprise/Standard split you used in Freshdesk."
      ]
    },
    {
      "title": "Bidirectional Freshdesk Airsync (parallel-run period)",
      "doc_links": [
        "https://developer.devrev.ai/airsync/about"
      ],
      "steps": [
        "Settings → Integrations → Snap-ins",
        "Install the Freshdesk Airsync snap-in",
        "Authenticate against your Freshdesk subdomain (read-only API key recommended for parallel-run)",
        "Map Freshdesk Products → DevRev Parts (use the parts hierarchy seeded above as the target)",
        "Enable bidirectional ticket sync until you cut over",
        "Disable sync after cutover and import the final delta CSV"
      ]
    },
    {
      "title": "Importing your real Freshdesk export",
      "steps": [
        "Export tickets from Freshdesk → Admin → Account → Data Exports.",
        "Drop the CSV next to this blueprint and add a `csv` entry: `{ \"path\": \"./fd-tickets.csv\", \"entity\": \"tickets\" }`.",
        "The agent auto-detects Freshdesk headers (Ticket ID, Requester Name, Agent Name, Priority Name, Status Name) and applies the column map automatically.",
        "Override mappings via `column_map` if your export has custom columns."
      ]
    }
  ],
